# ===========================================
# 🎨 Sonic NFT Studio - Environment Variables
# ===========================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to git!

# ===========================================
# 🤖 AI IMAGE GENERATION APIs
# ===========================================

# OpenAI DALL-E 3 (Recommended - Best Quality)
# Get from: https://platform.openai.com/api-keys
# Cost: ~$0.04 per image
OPENAI_API_KEY=sk-your_openai_api_key_here

# Stability AI SDXL (Professional Quality)
# Get from: https://platform.stability.ai/
# Cost: Free tier available, then ~$0.01 per image
STABILITY_API_KEY=sk-gxBtghQP4HIfUAk6CZqOEihbGtw6aAZRTbirfAoI9Amv3hNL

# Replicate (Multiple Models)
# Get from: https://replicate.com/
# Cost: ~$0.01-0.05 per image
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Hugging Face (Free Option)
# Get from: https://huggingface.co/settings/tokens
# Cost: Free tier available
HUGGINGFACE_API_KEY=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

# ===========================================
# 🔐 WALLET CONFIGURATION
# ===========================================

# Private Key for Contract Deployment (NEVER SHARE!)
# Get from MetaMask: Account Details > Export Private Key
# Format: (64 characters)
PRIVATE_KEY=1b890461d2c11ecdbcd832a6ae7f2ad62fddb8cfc3be237dbc3cb0585de18039

# ===========================================
# 🌐 SONIC NETWORK CONFIGURATION
# ===========================================

# Sonic Testnet RPC URL
SONIC_TESTNET_RPC_URL=https://rpc.testnet.soniclabs.com

# Sonic Mainnet RPC URL (for production)
SONIC_MAINNET_RPC_URL=https://rpc.soniclabs.com

# Sonic Testnet API Key (for contract verification)
# Get from: https://testnet.sonicscan.org/
SONIC_TESTNET_API_KEY=your_sonic_testnet_api_key_here

# Sonic Mainnet API Key (for production)
# Get from: https://sonicscan.org/
SONIC_MAINNET_API_KEY=your_sonic_mainnet_api_key_here

# ===========================================
# 📦 IPFS STORAGE (Optional - for production)
# ===========================================

# Pinata IPFS Service
# Get from: https://pinata.cloud/
PINATA_API_KEY=ddcb772a92941e8d8093
PINATA_SECRET_KEY=9d613f71940d2bab09ed54dc9a95af21c336c91c52ef0cf425331a62cfa7eb1d

# Infura IPFS Service
# Get from: https://infura.io/
INFURA_PROJECT_ID=your_infura_project_id_here
INFURA_PROJECT_SECRET=your_infura_project_secret_here

# ===========================================
# 🗄 DATABASE (Optional - for production)
# ===========================================

# PostgreSQL Database URL
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://username:password@localhost:5432/sonic_nft_db

# MongoDB Database URL
# Format: mongodb://username:password@host:port/database
MONGODB_URL=mongodb://localhost:27017/sonic_nft_db

# ===========================================
# 🔧 APPLICATION CONFIGURATION
# ===========================================

# Backend Port (default: 8000)
BACKEND_PORT=8000

# Frontend Port (default: 3000)
FRONTEND_PORT=3000

# Environment (development, staging, production)
NODE_ENV=development

# JWT Secret for API authentication
JWT_SECRET=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..m28MXomLlo4MiiO59u3nHbPVstgcjGu6jaSeCQUBWRI

# ===========================================
# 📊 MONITORING & ANALYTICS (Optional)
# ===========================================

# Google Analytics ID
