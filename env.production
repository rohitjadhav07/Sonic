# Production Environment Variables for Vercel Deployment
# Copy these to Vercel Environment Variables in dashboard

# AI Image Generation
STABILITY_API_KEY=your_stability_api_key_here

# IPFS Storage
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_KEY=your_pinata_secret_key_here

# Wallet Configuration
PRIVATE_KEY=your_wallet_private_key_here

# JWT Secret
JWT_SECRET=your_jwt_secret_here

# Sonic Network
SONIC_TESTNET_RPC_URL=https://rpc.testnet.soniclabs.com

# Frontend Configuration
NEXT_PUBLIC_API_URL=https://sonic-nft-studio.vercel.app/api
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS=0x1234567890abcdef1234567890abcdef12345678
