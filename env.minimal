# ===========================================
# 🎨 Sonic NFT Studio - Minimal Environment Variables
# ===========================================
# Copy this file to .env and fill in your actual values
# ONLY REQUIRED KEYS FOR STABILITY AI + IPFS

# ===========================================
# 🤖 AI IMAGE GENERATION - Stability AI
# ===========================================

# Stability AI SDXL (Professional Quality)
# Get from: https://platform.stability.ai/
# Cost: Free tier available, then ~$0.01 per image
STABILITY_API_KEY=your_stability_api_key_here

# ===========================================
# 🔐 WALLET CONFIGURATION
# ===========================================

# Private Key for Contract Deployment (NEVER SHARE!)
# Get from MetaMask: Account Details > Export Private Key
# Format: 0x1234567890abcdef... (64 characters)
PRIVATE_KEY=0xyour_wallet_private_key_here

# ===========================================
# 📦 IPFS STORAGE - Pinata
# ===========================================

# Pinata IPFS Service (Recommended)
# Get from: https://pinata.cloud/
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_KEY=your_pinata_secret_key_here

# ===========================================
# 🌐 SONIC NETWORK CONFIGURATION
# ===========================================

# Sonic Testnet RPC URL
SONIC_TESTNET_RPC_URL=https://rpc.testnet.soniclabs.com

# ===========================================
# 📚 GETTING API KEYS - QUICK LINKS
# ===========================================

# 1. Stability AI: https://platform.stability.ai/
#    - Create account
#    - Go to API Keys section
#    - Generate new API key
#    - Free tier: 25 credits per month

# 2. Pinata IPFS: https://pinata.cloud/
#    - Create account
#    - Go to API Keys section
#    - Generate API Key and Secret
#    - Free tier: 1GB storage

# 3. Wallet Private Key:
#    - Open MetaMask
#    - Click account menu (three dots)
#    - Account Details > Export Private Key
#    - Enter password and copy key

# 4. Test S Tokens:
#    - Add Sonic Testnet to MetaMask
#    - Visit: https://faucet.testnet.soniclabs.com
#    - Request test tokens


